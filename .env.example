DATABASE_URL=postgres://pasaree:rahasia@localhost:5432/pasaree
JWT_AUD=pasaree
JWT_ISSUER=pasaree-auth
# Rahasia penandatangan JWT (HS256); wajib diganti di produksi, minimal 32 karakter.
JWT_SECRET=ganti-dengan-rahasia-acak-minimal-32-karakter
PORT=8101
# Proksi Lumbung memakai service key least-privilege (bukan token pengguna).
LUMBUNG_BASE_URL=http://localhost:8102
LUMBUNG_SERVICE_KEY=ganti-service-key-lumbung
